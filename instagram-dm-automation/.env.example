# Instagram Graph API credentials (see README.md "Instagram API Setup" for how to obtain these)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
FACEBOOK_APP_SECRET=
WEBHOOK_VERIFY_TOKEN=

# Database
DATABASE_URL=sqlite:///./app.db

# Graph API version to call (kept configurable so it's easy to bump later)
GRAPH_API_VERSION=v21.0
