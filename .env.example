# ---- Server ----
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
PUBLIC_URL=http://localhost:3000

# ---- Security (required in production) ----
# Generate with: openssl rand -hex 32
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d
# Comma-separated origins, or * to allow any
CORS_ORIGIN=*
# Set to 1 when running behind a reverse proxy / load balancer
TRUST_PROXY=

# ---- Data ----
# Directory for the JSON datastore (mount a volume here in production)
DATA_DIR=./data
# Set to false to start with an empty database (no demo workspace)
SEED_DEMO_DATA=true

# ---- AI (optional) ----
# Without a key, Content Studio uses the built-in generator.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=low

# ---- Limits ----
MAX_VIDEO_BYTES=209715200

# ---- Laqtah mobile app (/laqtah) — all optional ----
# Higgsfield keys for video/image generation (console.higgsfield.ai). Kept server-side;
# the app calls /api/laqtah/hf/*. Without them the app shows its "connect Higgsfield" prompt.
HF_API_KEY_ID=
HF_API_KEY_SECRET=
# Extra allowed model paths, comma-separated
HF_EXTRA_MODELS=
# URL of deploy/laqtah/youtube-import.mjs (needs yt-dlp; runs as its own service)
LAQTAH_YOUTUBE_IMPORT_URL=
# Google Drive picker (OAuth web client + API key with Picker and Drive APIs enabled)
LAQTAH_GOOGLE_CLIENT_ID=
LAQTAH_GOOGLE_API_KEY=
LAQTAH_GOOGLE_APP_ID=
# Clip selection and caption translation use ANTHROPIC_API_KEY above.
