# ---- Server ----
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
PUBLIC_URL=http://localhost:3000

# ---- Security (required in production) ----
# Generate with: openssl rand -hex 32
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d
# Comma-separated origins, or * to allow any
CORS_ORIGIN=*
# Set to 1 when running behind a reverse proxy / load balancer
TRUST_PROXY=

# ---- Data ----
# Directory for the JSON datastore (mount a volume here in production)
DATA_DIR=./data
# Set to false to start with an empty database (no demo workspace)
SEED_DEMO_DATA=true

# ---- AI (optional) ----
# Without a key, Content Studio uses the built-in generator.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=low

# ---- Limits ----
MAX_VIDEO_BYTES=209715200
